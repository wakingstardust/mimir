+/// MIMIR_HTTP_SNAPSHOT=1 serves a read-only index snapshot. Any commit from
+/// another connection (including the timer's WAL-truncate checkpoint) bumps
+/// `data_version` and drops the vector matrix, so on a slow disk the next
+/// recall rebuilds it from the whole DB. With no impression writes and no
+/// timer, nothing commits and the matrix stays loaded.
+fn snapshot_mode() -> bool {
+    std::env::var("MIMIR_HTTP_SNAPSHOT").is_ok_and(|v| v == "1")
+}
